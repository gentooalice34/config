super + Return
	kitty
super + q
	bspc node -c
super + m 
	bspc node focused --flag hidden -f
super + alt + m
	~/.config/sxhkd/hide.sh
super + f
	bspc node -t fullscreen
super + c
	~/.config/sxhkd/centre.sh
super + {1-9,0}
	bspc desktop -f '^{1-9,0}'
super + shift + {1-9,0}
	bspc node -d '^{1-9,0}'
super + Tab
	bspc node -f next.local
super + shift + Tab
	bspc node -f prev.local
super + h
	bspc node -f west
super + j
	bspc node -f south
super + k
	bspc node -f north
super + l
	bspc node -f east
super + shift + h
	bspc node -s west
super + shift + j
	bspc node -s south
super + shift + k
	bspc node -s north
super + shift + l
	bspc node -s east
super + {Left,Down,Up,Right}
	bspc node -f {west,south,north,east}
super + shift + {Left,Down,Up,Right}
	bspc node -s {west,south,north,east}
super + ctrl + {h,j,k,l}
	bspc node -p {west,south,north,east}
super + ctrl + shift + {h,j,k,l}
	bspc node -o {west,south,north,east}
super + r
	bspc node -R
super + shift + r
	bspc wm -r
super + s
	bspc node -t floating
super + d 
	~/.config/rofi/launchers/type-3/launcher.sh
Print
	scrot -e 'mv $f ~/Pictures/Screenshots/'
super + Print
	scrot -s -e 'mv $f ~/Pictures/Screenshots/'
super + b
	firefox-bin
super + alt + b
	chromium-bin
super + shift + button3
	bspc node -g resizing=1
super + shift + button1
	bspc node -v begin -e end
super + t
	bspc node -t tiled
super + x
	code
super + e
	kitty -e spf
super + shift + e
	thunar
super + p
	steam
# Поменять местами с окном в направлении (SWAP)
super + alt + {h,j,k,l}
  bspc node -s {west,south,north,east} --follow

# Поменять местами с самым большим окном на столе
super + space
  bspc node -s biggest.local --follow

# ===== ДИНАМИЧЕСКИЕ ГЭПЫ =====
super + ctrl + plus
  bspc config window_gap $(($(bspc config window_gap) + 4))
super + ctrl + minus
  bspc config window_gap $(($(bspc config window_gap) - 4))

# ===== РЕСАЙЗ КЛАВИШАМИ =====
super + ctrl + {Left,Down,Up,Right}
  bspc node -z {right -20 0,bottom 0 20,bottom 0 -20,right 20 0}

# ===== ОЧИСТКА И ОРГАНИЗАЦИЯ =====
super + shift + q
  bspc query -N -d focused | xargs bspc node -c
super + ctrl
  bspc query -N -d focused | xargs bspc node -E


